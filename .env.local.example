# Copy to .env.local and fill from the Supabase project settings
# (Project Settings → API). Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# Optional server-only aliases (used as fallback by src/lib/supabase/env.ts)
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
