# Copy to .env.local and fill from Supabase → Project Settings → API.
# Never commit .env.local. Prefer server-only names (no NEXT_PUBLIC_* keys).

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_or_publishable_key
# Required for the private Cursor app (server actions / RSC). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
